{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "bash \"${COPILOT_PLUGIN_ROOT}/hooks/sensitive-data-guard.sh\"",
        "matcher": "read|bash|powershell",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "bash \"${COPILOT_PLUGIN_ROOT}/hooks/compliance-scan.sh\"",
        "matcher": "write|edit|multiEdit",
        "timeoutSec": 10
      }
    ]
  }
}
